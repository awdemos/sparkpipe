updaterepo_select_validations()
{
    if updaterepo_changed_any .updaterepo-policy Makefile include model_contracts modules src tests tools
    then
        UPDATEREPO_VALIDATE_COMMANDS+=("make -j test")
    fi
    if updaterepo_changed_any Makefile include modules/glm52_resident_decode_stage
    then
        UPDATEREPO_VALIDATE_COMMANDS+=("test -x /usr/local/cuda/bin/nvcc")
        UPDATEREPO_VALIDATE_COMMANDS+=("make -C modules/glm52_resident_decode_stage -j archive NVCC=/usr/local/cuda/bin/nvcc CUDA_ARCH=sm_121a")
        UPDATEREPO_VALIDATE_COMMANDS+=("make -j glm52_pp13_node_context_builder NVCC=/usr/local/cuda/bin/nvcc CUDA_ARCH=sm_121a")
    fi
    if updaterepo_changed_any Makefile include modules/hidden_transport_tcp_cuda.cu
    then
        UPDATEREPO_VALIDATE_COMMANDS+=("test -x /usr/local/cuda/bin/nvcc")
        UPDATEREPO_VALIDATE_COMMANDS+=("make -j hidden_transport_tcp_cuda NVCC=/usr/local/cuda/bin/nvcc CUDA_ARCH=sm_121a")
    fi
    if updaterepo_changed_any Makefile include modules/hidden_transport_spark_host_rdma_verbs.cu
    then
        UPDATEREPO_VALIDATE_COMMANDS+=("test -x /usr/local/cuda/bin/nvcc")
        UPDATEREPO_VALIDATE_COMMANDS+=("make -j hidden_transport_spark_host_rdma_verbs NVCC=/usr/local/cuda/bin/nvcc CUDA_ARCH=sm_121a")
    fi
    if updaterepo_changed_any Makefile include modules/glm52_dspark_draft_backend
    then
        UPDATEREPO_VALIDATE_COMMANDS+=("test -x /usr/local/cuda/bin/nvcc")
        UPDATEREPO_VALIDATE_COMMANDS+=("make -j glm52_dspark_draft_backend NVCC=/usr/local/cuda/bin/nvcc CUDA_ARCH=sm_121a")
    fi
    if updaterepo_changed_any Makefile include modules/glm52_sm121_b12x_compiled_backend modules/glm52_sm121_flashinfer_b12x_moe
    then
        UPDATEREPO_VALIDATE_COMMANDS+=("test -x /usr/local/cuda/bin/nvcc")
        UPDATEREPO_VALIDATE_COMMANDS+=("make -B -C modules/glm52_sm121_b12x_compiled_backend -j archive NVCC=/usr/local/cuda/bin/nvcc CUDA_ARCH=sm_121a")
        UPDATEREPO_VALIDATE_COMMANDS+=("make -B -C modules/glm52_sm121_flashinfer_b12x_moe -j archive NVCC=/usr/local/cuda/bin/nvcc CUDA_ARCH=sm_121a")
    fi
}
